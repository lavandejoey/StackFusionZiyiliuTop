{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node18",
    "lib": ["ES2020"],
    "strict": true,
    "baseUrl": "./",
    "outDir": "dist",
    "typeRoots": ["src/types", "node_modules/@types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": ["src/*"],
      "@config/*": ["config/*"]
    },
    "useUnknownInCatchVariables": false,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts",
    "eslint.config.ts",
    "vitest.config.ts"
  ]
}

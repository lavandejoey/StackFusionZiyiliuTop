{
  "name": "backend",
  "version": "3.0.0",
  "description": "REST API server for Stack Fusion Ziyiliu",
  "keywords": [
    "backend",
    "api",
    "express",
    "typescript"
  ],
  "author": "Ziyi LIU",
  "license": "MIT",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "clean": "rm -rf ./dist && rm -rf ./node_modules && rm -rf ./package-lock.json",
    "build": "tsc -p tsconfig.prod.json && cp -R ./config ./dist/config",
    "dev": "NODE_ENV=development REPO_CACHE_OVERWRITE=false ts-node -r tsconfig-paths/register src/index.ts",
    "dev:hot": "nodemon --exec \"npm run dev\" --watch ./src --ext .ts",
    "lint": "eslint . --fix",
    "start": "NODE_ENV=production node -r ./dist/config.js ./dist/index.js",
    "test": "NODE_ENV=test vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^5.0.0",
    "argon2": "^0.43.0",
    "axios": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "envalid": "^8.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "inserturlparams": "^2.0.5",
    "ioredis": "^5.6.1",
    "jet-env": "^1.1.4",
    "jet-logger": "^2.0.1",
    "jet-paths": "^1.1.0",
    "jet-validators": "^1.4.0",
    "jsonfile": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.22",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.1",
    "node-fetch": "^3.3.2",
    "postmark": "^4.0.5",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xss": "^1.0.15",
    "zod": "^3.22.4",
    "@octokit/core": "^4.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@stylistic/eslint-plugin": "^4.4.0",
    "@swc/core": "^1.11.29",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonfile": "^6.1.4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/katex": "^0.16.7",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.27.0",
    "eslint-plugin-n": "^17.18.0",
    "find": "^0.3.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.6.3",
    "jiti": "^2.4.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
